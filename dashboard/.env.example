# Copy to  dashboard/.env  for local runs (loaded via python-dotenv).
# On Render these are set as real env vars. Gitignored — never commit.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxx
# Optional: Supabase dashboard -> Settings -> API -> "anon public" key.
# Read-only dashboard queries (load_*) use this instead of the service-role
# key above — defense in depth, since every table they read has an
# anon SELECT-only RLS policy and no write policy at all. Leave empty to
# fall back to the service-role key for reads too (same data, slightly
# weaker boundary) — safe to deploy before this is set.
SUPABASE_ANON_KEY=

# Optional: if either is set, /admin (推播設定/顯示設定/警戒設定) requires
# this account+password to log in. Leave both empty for an open admin page
# (local dev only).
DASH_USERNAME=
# A bcrypt hash of the password, NEVER the plaintext password itself.
# Generate one with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
DASH_PASSWORD_HASH=

# Optional brute-force guards for the /admin and /ask login forms, each with
# a built-in default if unset:
# LOGIN_MAX_ATTEMPTS=5        # failed attempts from one browser before it's locked out
# LOGIN_SITE_MAX_ATTEMPTS=20  # failed attempts site-wide (catches cookie-clearing bypass)
# LOGIN_LOCKOUT_SECONDS=900   # how long a lockout lasts (15 min)

# Optional: /ask (AI 問答) page. Get a key from Google AI Studio
# (https://aistudio.google.com/apikey) — never commit a real key here or
# anywhere else in the repo. Leave empty to keep /ask disabled ("功能未啟用").
GEMINI_API_KEY=
# A specific stable model id, e.g. gemini-3.8-flash — the model lineup moves
# fast and old models get shut down, so check
# https://ai.google.dev/gemini-api/docs/models and .../deprecations for exact
# names rather than assuming one is still current. A "...-latest" rolling
# alias looks appealing (never goes stale, in theory) but broke /ask in
# production once the model it pointed to was shut down — pin a specific
# stable id instead. Leave empty to fall back to the code's own default.
GEMINI_MODEL=

# Optional abuse/cost guards for /ask, each with a built-in default if unset:
# ASK_RATE_PER_MINUTE=6
# ASK_RATE_PER_DAY=60
# ASK_RATE_SITE_PER_DAY=500
# Require the same DASH_USERNAME/DASH_PASSWORD login as /admin before /ask
# will answer a question. Defaults to "false" (open), set "true" to match
# /admin's gate.
ASK_REQUIRE_AUTH=false

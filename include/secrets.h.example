// ============================================================================
//  secrets.h.example  ->  copy to  include/secrets.h  and fill in.
//  include/secrets.h is git-ignored. NEVER commit real credentials.
// ============================================================================
#pragma once

// --- Wi-Fi ----------------------------------------------------------------
// NOTE: Wi-Fi creds are entered through the WiFiManager captive portal at
// runtime (AP "AquaGuardian-Setup"), NOT from here. These two are kept only
// so the file matches; the firmware does not read them.
#define WIFI_SSID       "unused-set-via-portal"
#define WIFI_PASS       "unused-set-via-portal"

// --- HiveMQ Cloud (Serverless free tier) ----------------------------------
// These are DEFAULTS. The captive portal can override them into NVS.
// Cluster URL from the HiveMQ Cloud console, e.g. abcd1234.s1.eu.hivemq.cloud
#define MQTT_HOST       "xxxxxxxx.s1.eu.hivemq.cloud"
#define MQTT_PORT       8883                 // TLS
#define MQTT_USER       "esp32"
#define MQTT_PASS       "your-mqtt-password"

// --- Identity ------------------------------------------------------------
// DEVICE_ID is only the DEFAULT. Flash the same image to every board and set
// a unique "裝置 ID" (esp32-aqua-02, ...) in the captive portal per board.
#define SITE_ID         "home"
#define DEVICE_ID       "esp32-aqua-01"
#define FW_VERSION      "0.1.0"

# Copy to  worker/.env  for local testing (python-dotenv is NOT loaded by
# ingest.py in production — Render injects these as real env vars).
# For local runs:  set -a; source .env; set +a; python ingest.py

MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=esp32
MQTT_PASS=your-mqtt-password
MQTT_TOPIC=aquaponics/+/+/telemetry

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role...

# Optional: LINE push when a threshold is breached. Leave blank to disable.
# Messaging API channel access token (LINE Developers Console), NOT the
# discontinued LINE Notify. See docs/architecture.md for setup steps.
LINE_CHANNEL_TOKEN=

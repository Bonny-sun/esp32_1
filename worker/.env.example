# Copy to  worker/.env  for local testing (python-dotenv is NOT loaded by
# ingest.py in production — Render injects these as real env vars).
# For local runs:  set -a; source .env; set +a; python ingest.py

MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=esp32
MQTT_PASS=your-mqtt-password
MQTT_TOPIC=aquaponics/+/+/telemetry

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role...

# Optional: LINE push when a threshold is breached. Leave blank to disable.
# Messaging API channel access token (LINE Developers Console), NOT the
# discontinued LINE Notify. See docs/architecture.md for setup steps.
LINE_CHANNEL_TOKEN=

# Optional: stock_alerts.py — a DIFFERENT app's (auto-stock-picker)
# twice-daily price-alert job, piggybacked on this worker. Leave both
# blank to disable (see stock_alerts.py's own module docstring).
# STOCK_DATABASE_URL must be Supabase's connection-POOLER string (IPv4),
# not the direct db.<ref>.supabase.co host — Render has no outbound IPv6.
STOCK_DATABASE_URL=
# A SEPARATE LINE channel token from LINE_CHANNEL_TOKEN above — do not
# reuse the aquaponics system's own token here.
STOCK_LINE_CHANNEL_ACCESS_TOKEN=
